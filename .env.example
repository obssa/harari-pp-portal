# Template for the server .env (staging on cPanel, ADR-0002).
# The real .env lives only on the server and is never deployed or committed.
APP_NAME="Harari Prosperity Party"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://hararipp.orcamind.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Shared cPanel has no Redis: database-backed cache, sessions and queue.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=hararipp

# Search: database driver on cPanel, meilisearch on a VPS later.
SCOUT_DRIVER=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.orcamind.dev
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@orcamind.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Staging only: allows `php artisan portal:demo-accounts` (one sample account per role).
PORTAL_DEMO_ACCOUNTS=false

VITE_APP_NAME="${APP_NAME}"

# Template for the server .env (staging on cPanel, ADR-0002).
# The real .env lives only on the server and is never deployed or committed.
APP_NAME="Harari Prosperity Party"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://hararipp.orcamind.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Shared cPanel has no Redis: database-backed cache, sessions and queue.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=hararipp

# Search: database driver on cPanel, meilisearch on a VPS later.
SCOUT_DRIVER=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.orcamind.dev
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@orcamind.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Staging only: allows `php artisan portal:demo-accounts` (one sample account per role).
PORTAL_DEMO_ACCOUNTS=false

# Days after an event that registrations are kept (ADR-0025).
PORTAL_REGISTRATION_RETENTION_DAYS=180
# Days after a ticket is resolved that it is kept (ADR-0041).
PORTAL_SUBMISSION_RETENTION_DAYS=730
# Days after a rejected or withdrawn membership application is decided that it is kept (ADR-0044).
PORTAL_CLOSED_APPLICATION_RETENTION_DAYS=180
PORTAL_MEMBERSHIP_REMINDER_DAYS=30
PORTAL_MEMBERSHIP_GRACE_DAYS=90
PORTAL_CAMPAIGN_EMAIL_PER_MINUTE=200
PORTAL_CAMPAIGN_SMS_PER_MINUTE=30
PORTAL_CAMPAIGN_OPEN_TRACKING=false
# Requests per minute a new API key gets (ADR-0056); days a member stays signed in to the app (ADR-0057).
PORTAL_API_DEFAULT_RATE=60
PORTAL_MEMBER_TOKEN_DAYS=90
# Requests or jobs spending longer than this in the database are logged; 0 turns it off (ADR-0061).
PORTAL_SLOW_QUERIES_MS=1000

# Health and backups (ADR-0037). The archive password must also be kept outside the server.
PORTAL_STORAGE_QUOTA_MB=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_OFFSITE_DISK=
BACKUP_MAX_MEGABYTES=5000
# Security (ADR-0038): admin only from these addresses or CIDR ranges (comma-separated; empty: all),
# and error reports to Sentry once a DSN is set.
PORTAL_ADMIN_ALLOWED_IPS=
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
# A second, empty database for the monthly restore drill (docs/runbook/restore.md).
DB_DRILL_DATABASE=
DB_DRILL_USERNAME=
DB_DRILL_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

{
    "ci": {
        "collect": {
            "url": [
                "https://hararipp.orcamind.dev/en",
                "https://hararipp.orcamind.dev/am",
                "https://hararipp.orcamind.dev/am/news/ameraru-yehizib-ageligay-bemehon-yetetalebetin-adera-liweta-yigebal-ato-oridin-bediri",
                "https://hararipp.orcamind.dev/en/events",
                "https://hararipp.orcamind.dev/en/documents"
            ],
            "numberOfRuns": 3,
            "settings": {
                "onlyCategories": ["performance", "accessibility", "best-practices"],
                "extraHeaders": "{\"Cache-Control\": \"no-cache\"}"
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
                "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
                "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
                "resource-summary:document:size": ["error", { "maxNumericValue": 61440 }],
                "resource-summary:script:size": ["error", { "maxNumericValue": 81920 }],
                "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
                "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": "lighthouse-reports"
        }
    }
}
